<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IQ OS — Cognitive Command Center</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #080808;
  --bg2: #0f0f0f;
  --bg3: #161616;
  --border: #1e1e1e;
  --border2: #2a2a2a;
  --green: #00ff87;
  --green-dim: rgba(0,255,135,0.08);
  --green-glow: rgba(0,255,135,0.18);
  --amber: #ffb347;
  --blue: #74b9ff;
  --pink: #fd79a8;
  --red: #ff4757;
  --text: #e8e8e8;
  --text2: #888;
  --text3: #3a3a3a;
  --mono: 'Space Mono', monospace;
  --display: 'Syne', sans-serif;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--text);font-family:var(--mono);height:100vh;overflow:hidden;display:flex;flex-direction:column}
body::before{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.025) 2px,rgba(0,0,0,0.025) 4px);pointer-events:none;z-index:9999}

/* TOPBAR */
.topbar{height:52px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;border-bottom:1px solid var(--border);background:var(--bg);flex-shrink:0;z-index:200}
.logo{font-family:var(--display);font-weight:800;font-size:1.15rem;letter-spacing:-.5px;display:flex;align-items:center;gap:10px}
.logo .iq{color:var(--green)}.logo .os{color:var(--text3)}
.logo-tag{font-family:var(--mono);font-size:.52rem;color:var(--text3);border:1px solid var(--border2);padding:2px 6px;letter-spacing:2px;text-transform:uppercase}
.topbar-right{display:flex;align-items:center;gap:24px}
.sys-clock{font-size:.78rem;color:var(--green);font-weight:700;letter-spacing:2px;text-shadow:0 0 12px rgba(0,255,135,.3)}
.sys-date{font-size:.6rem;color:var(--text3);letter-spacing:1px}

/* NAV */
.nav{height:42px;display:flex;align-items:stretch;border-bottom:1px solid var(--border);background:var(--bg);flex-shrink:0;padding:0 20px;gap:2px}
.nav-btn{font-family:var(--mono);font-size:.6rem;letter-spacing:2px;text-transform:uppercase;color:var(--text3);background:none;border:none;border-bottom:2px solid transparent;padding:0 16px;cursor:pointer;transition:color .12s,border-color .12s;display:flex;align-items:center;gap:7px}
.nav-btn:hover{color:var(--text2)}.nav-btn.active{color:var(--green);border-bottom-color:var(--green)}

/* PAGES */
.pages{flex:1;overflow:hidden;position:relative}
.page{position:absolute;inset:0;overflow-y:auto;overflow-x:hidden;display:none}
.page.active{display:flex;flex-direction:column}
.page::-webkit-scrollbar{width:4px}.page::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}

/* SHARED */
.section-label{font-size:.52rem;letter-spacing:3px;text-transform:uppercase;color:var(--text3);margin-bottom:12px}
select,input[type="text"],textarea{background:var(--bg3);border:1px solid var(--border2);color:var(--text);font-family:var(--mono);font-size:.74rem;padding:9px 12px;width:100%;outline:none;transition:border-color .15s,box-shadow .15s;border-radius:2px}
select:focus,input[type="text"]:focus,textarea:focus{border-color:var(--green);box-shadow:0 0 0 2px var(--green-dim)}
select option{background:var(--bg3)}
textarea{resize:vertical;line-height:1.65}
.btn{font-family:var(--mono);font-size:.65rem;letter-spacing:1.5px;text-transform:uppercase;padding:9px 18px;border:1px solid var(--border2);background:transparent;color:var(--text2);cursor:pointer;transition:all .12s;border-radius:2px}
.btn:hover{border-color:var(--text2);color:var(--text)}
.btn-green{border-color:var(--green);color:var(--green);background:var(--green-dim)}
.btn-green:hover{background:var(--green-glow);box-shadow:0 0 16px rgba(0,255,135,.15)}
.btn-red{border-color:var(--red);color:var(--red);background:rgba(255,71,87,.05)}
.btn-red:hover{background:rgba(255,71,87,.12)}
input[type="color"]{width:36px;height:36px;padding:3px;background:var(--bg3);border:1px solid var(--border2);border-radius:2px;cursor:pointer}

/* ══ TRACKER PAGE ══ */
#page-tracker.active{display:grid;grid-template-columns:300px 1fr 300px;overflow:hidden}
.tracker-panel{display:flex;flex-direction:column;overflow:hidden;border-right:1px solid var(--border)}
.tracker-panel:last-child{border-right:none;border-left:1px solid var(--border)}
.panel-head{padding:18px 20px 14px;border-bottom:1px solid var(--border);background:var(--bg2);flex-shrink:0}
.panel-title{font-family:var(--display);font-weight:700;font-size:.88rem;margin-bottom:3px}
.panel-sub{font-size:.57rem;color:var(--text3);letter-spacing:1px}
.panel-scroll{flex:1;overflow-y:auto;padding:14px 16px}
.panel-scroll::-webkit-scrollbar{width:3px}.panel-scroll::-webkit-scrollbar-thumb{background:var(--border2)}

/* Timer center */
.tracker-center{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 28px;gap:0;position:relative;overflow:hidden}
.tracker-center::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at center,rgba(0,255,135,.035) 0%,transparent 68%);pointer-events:none}
.big-timer{font-family:var(--display);font-size:5.2rem;font-weight:800;color:var(--green);letter-spacing:-3px;line-height:1;text-shadow:0 0 60px rgba(0,255,135,.22);text-align:center}
.big-timer.running{animation:tPulse 1.4s ease-in-out infinite alternate}
@keyframes tPulse{from{text-shadow:0 0 30px rgba(0,255,135,.2)}to{text-shadow:0 0 70px rgba(0,255,135,.6),0 0 120px rgba(0,255,135,.15)}}
.big-timer-sub{font-size:.62rem;color:var(--text3);letter-spacing:3px;text-transform:uppercase;margin-top:10px;height:16px;transition:color .2s}
.big-timer-sub.on{color:var(--green)}
.timer-dot{width:7px;height:7px;border-radius:50%;background:var(--text3);margin-top:18px;transition:background .3s,box-shadow .3s}
.timer-dot.running{background:var(--green);box-shadow:0 0 10px var(--green);animation:dotBlink 1s ease-in-out infinite alternate}
@keyframes dotBlink{from{opacity:.5}to{opacity:1}}
.timer-subject-sel{width:220px;margin-top:18px;text-align:center}
.timer-btns{display:flex;gap:10px;margin-top:22px}

/* Subjects list */
.subject-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1px solid var(--border);border-radius:2px;margin-bottom:6px;cursor:pointer;transition:all .12s;font-size:.7rem}
.subject-item:hover{border-color:var(--border2);background:var(--bg3)}
.subject-item.active{border-color:var(--green);background:var(--green-dim)}
.subj-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.subj-name{flex:1}
.subj-hrs{font-size:.58rem;color:var(--text3)}
.subj-del{font-size:.58rem;color:var(--text3);cursor:pointer;opacity:0;padding:2px 4px;transition:opacity .1s,color .1s}
.subject-item:hover .subj-del{opacity:1}.subj-del:hover{color:var(--red)}

.add-subj-wrap{padding:12px 16px;border-top:1px solid var(--border);background:var(--bg2);flex-shrink:0}
.add-subj-row{display:grid;grid-template-columns:1fr auto auto;gap:6px;margin-top:10px}

/* Today sessions */
.today-sess{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--border);border-left-width:3px;border-radius:2px;margin-bottom:8px;font-size:.7rem}
.today-sess-dur{margin-left:auto;color:var(--green);font-weight:700}
.today-sess-note{font-size:.57rem;color:var(--text3);max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.streak-block{border-top:1px solid var(--border);padding:16px 20px;background:var(--bg2);display:flex;align-items:center;gap:14px;flex-shrink:0}
.streak-num{font-family:var(--display);font-size:2.4rem;font-weight:800;color:var(--amber);line-height:1}
.streak-info{display:flex;flex-direction:column;gap:3px}
.streak-lbl{font-size:.57rem;color:var(--text3);letter-spacing:2px;text-transform:uppercase}
.streak-sub{font-size:.52rem;color:var(--text3)}

/* ══ CALENDAR PAGE ══ */
#page-calendar.active{display:flex;flex-direction:column}
.cal-top{display:flex;align-items:center;justify-content:space-between;padding:18px 28px;border-bottom:1px solid var(--border);background:var(--bg);flex-shrink:0}
.cal-month{font-family:var(--display);font-size:1.1rem;font-weight:700}
.cal-nav{font-family:var(--mono);font-size:.62rem;background:none;border:1px solid var(--border2);color:var(--text2);padding:7px 16px;cursor:pointer;transition:all .12s;border-radius:2px}
.cal-nav:hover{border-color:var(--green);color:var(--green)}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);border-left:1px solid var(--border);border-top:1px solid var(--border);flex:1}
.cal-hd{padding:10px;text-align:center;font-size:.52rem;letter-spacing:2.5px;color:var(--text3);text-transform:uppercase;border-right:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--bg2)}
.cal-day{border-right:1px solid var(--border);border-bottom:1px solid var(--border);padding:8px;min-height:100px;cursor:pointer;transition:background .1s;position:relative}
.cal-day:hover{background:var(--bg2)}.cal-day.today{background:rgba(0,255,135,.03)}.cal-day.today .cal-dn{color:var(--green)}.cal-day.empty{background:var(--bg);opacity:.25;cursor:default}
.cal-dn{font-size:.65rem;color:var(--text2);margin-bottom:5px}
.cal-pill{font-size:.52rem;padding:2px 6px;border-radius:2px;margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;font-weight:700;letter-spacing:.5px}
.cal-tot{position:absolute;bottom:5px;right:7px;font-size:.48rem;color:var(--text3);letter-spacing:1px}

/* ══ KOLB PAGE ══ */
#page-kolb.active{display:flex;flex-direction:column;overflow:hidden}
.kolb-topbar{display:flex;align-items:center;justify-content:space-between;padding:13px 22px;border-bottom:1px solid var(--border);background:var(--bg2);flex-shrink:0;gap:14px;flex-wrap:wrap}
.kolb-title{font-family:var(--display);font-size:.95rem;font-weight:700}
.kolb-badge{font-size:.5rem;letter-spacing:2px;text-transform:uppercase;border:1px solid var(--border2);padding:3px 8px;color:var(--text3);border-radius:2px}
.kolb-topbar-r{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.filter-btn{font-family:var(--mono);font-size:.58rem;letter-spacing:1.5px;text-transform:uppercase;padding:5px 12px;border:1px solid var(--border2);background:transparent;color:var(--text2);cursor:pointer;transition:all .12s;border-radius:2px}
.filter-btn:hover{color:var(--text)}.filter-btn.active{border-color:var(--green);color:var(--green);background:var(--green-dim)}

/* Table layout */
.kolb-table-wrap{flex:1;overflow:auto}
.kolb-table-wrap::-webkit-scrollbar{width:4px;height:4px}.kolb-table-wrap::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}

.kolb-table{width:100%;border-collapse:collapse;table-layout:fixed}

/* Header row */
.kolb-table thead tr{background:var(--bg2)}
.kolb-table th{
  padding:14px 18px;
  border-bottom:2px solid var(--border);
  border-right:1px solid var(--border);
  text-align:left;
  position:sticky;
  top:0;
  z-index:10;
  background:var(--bg2);
  width:25%;
}
.kolb-table th:last-child{border-right:none}
.kth-num{width:22px;height:22px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:700;margin-bottom:8px}
.kth-title{font-family:var(--display);font-size:.88rem;font-weight:700;margin-bottom:4px}
.kth-desc{font-size:.55rem;color:var(--text3);line-height:1.55;font-weight:400;font-family:var(--mono)}
.kth-cnt{font-size:.48rem;color:var(--text3);letter-spacing:2px;text-transform:uppercase;margin-top:8px;font-family:var(--mono)}

/* Body rows */
.kolb-table tbody tr{border-bottom:1px solid var(--border);transition:background .1s}
.kolb-table tbody tr:hover{background:var(--bg2)}
.kolb-table td{
  padding:14px 18px;
  border-right:1px solid var(--border);
  vertical-align:top;
  font-size:.72rem;
  color:var(--text2);
  line-height:1.65;
  white-space:pre-wrap;
  word-break:break-word;
  cursor:pointer;
}
.kolb-table td:last-child{border-right:none}

/* Row header (leftmost meta info — spans or shown in first col) */
.ktd-meta{display:flex;align-items:center;gap:7px;margin-bottom:8px;padding-bottom:7px;border-bottom:1px solid var(--border)}
.ktd-subj{font-size:.6rem;font-weight:700;letter-spacing:1px;text-transform:uppercase}
.ktd-dur{font-size:.6rem;color:var(--green);font-weight:700;margin-left:auto}
.ktd-date{font-size:.5rem;color:var(--text3)}
.ktd-empty{font-size:.65rem;color:var(--text3);font-style:italic}
.ktd-text{font-size:.72rem;color:var(--text2);line-height:1.65;white-space:pre-wrap;word-break:break-word}

.kolb-empty-row td{text-align:center;padding:50px 20px;font-size:.62rem;color:var(--text3);letter-spacing:2px;text-transform:uppercase;line-height:2.5;cursor:default}

/* Column accent colors */
.kc1-hd .kth-num{background:rgba(0,255,135,.1);color:var(--green)}.kc1-hd .kth-title{color:var(--green)}.kc1-hd{border-top:2px solid var(--green)!important}
.kc2-hd .kth-num{background:rgba(116,185,255,.1);color:var(--blue)}.kc2-hd .kth-title{color:var(--blue)}.kc2-hd{border-top:2px solid var(--blue)!important}
.kc3-hd .kth-num{background:rgba(255,179,71,.1);color:var(--amber)}.kc3-hd .kth-title{color:var(--amber)}.kc3-hd{border-top:2px solid var(--amber)!important}
.kc4-hd .kth-num{background:rgba(253,121,168,.1);color:var(--pink)}.kc4-hd .kth-title{color:var(--pink)}.kc4-hd{border-top:2px solid var(--pink)!important}
.kc1-td{border-left:3px solid rgba(0,255,135,.25)!important}
.kc2-td{border-left:3px solid rgba(116,185,255,.25)!important}
.kc3-td{border-left:3px solid rgba(255,179,71,.25)!important}
.kc4-td{border-left:3px solid rgba(253,121,168,.25)!important}

/* ══ OUTPUT PAGE ══ */
#page-output.active{display:flex;flex-direction:column;overflow-y:auto}
#page-output.active::-webkit-scrollbar{width:4px}
#page-output.active::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}

/* Compose section */
.out-write{display:flex;flex-direction:column;border-bottom:2px solid var(--border2)}
.out-head{padding:16px 22px 13px;border-bottom:1px solid var(--border);background:var(--bg2);flex-shrink:0}
.out-head-title{font-family:var(--display);font-size:.92rem;font-weight:700;margin-bottom:3px}
.out-head-sub{font-size:.57rem;color:var(--text3);letter-spacing:1px}
.out-compose{padding:14px 22px;min-height:60px}
.out-item{display:flex;align-items:flex-start;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);animation:sIn .16s ease}
@keyframes sIn{from{opacity:0;transform:translateX(-6px)}to{opacity:1;transform:translateX(0)}}
.out-bullet{color:var(--green);font-size:1rem;flex-shrink:0;margin-top:1px;line-height:1.5}
.out-item-txt{flex:1;font-size:.76rem;color:var(--text);line-height:1.55;word-break:break-word}
.out-item-del{font-size:.58rem;color:var(--text3);cursor:pointer;opacity:0;padding:2px 4px;transition:opacity .1s,color .1s;flex-shrink:0;margin-top:3px}
.out-item:hover .out-item-del{opacity:1}.out-item-del:hover{color:var(--red)}
.out-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;height:200px;color:var(--text3);font-size:.62rem;letter-spacing:1.5px;text-transform:uppercase;gap:10px}
.out-empty-icon{font-size:2.2rem;opacity:.15}
.out-add{border-top:1px solid var(--border);padding:12px 22px;display:flex;align-items:center;gap:10px;background:var(--bg);flex-shrink:0}
.out-add-bullet{color:var(--text3);font-size:1rem;flex-shrink:0}
.out-add-input{flex:1;background:transparent;border:none;border-bottom:1px solid var(--border2);border-radius:0;padding:6px 2px;font-size:.76rem;color:var(--text);outline:none;transition:border-color .15s;font-family:var(--mono)}
.out-add-input:focus{border-bottom-color:var(--green);box-shadow:none}
.out-add-input::placeholder{color:var(--text3);font-style:italic}
.out-foot{border-top:1px solid var(--border);padding:11px 22px;display:flex;align-items:center;justify-content:space-between;background:var(--bg2);flex-shrink:0}
.out-cnt{font-size:.58rem;color:var(--text3);letter-spacing:2px;text-transform:uppercase}

/* Past Accomplishments section */
.out-past{display:flex;flex-direction:column;background:var(--bg)}
.out-past-head{padding:16px 22px 13px;border-bottom:1px solid var(--border);background:var(--bg2);display:flex;align-items:baseline;justify-content:space-between;gap:12px}
.out-past-title{font-family:var(--display);font-size:.92rem;font-weight:700}
.out-past-total{font-size:.52rem;color:var(--text3);letter-spacing:2px;text-transform:uppercase}

/* No inner scroll — page scrolls */
.past-scroll{display:flex;flex-direction:column}

/* Date group */
.past-group{border-bottom:1px solid var(--border)}
.past-group-hd{
  position:sticky;top:94px;z-index:5;
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 22px;
  background:var(--bg3);
  border-bottom:1px solid var(--border);
  border-top:1px solid var(--border);
  gap:12px;
}
.past-group-label{font-family:var(--display);font-size:.82rem;font-weight:700}
.past-group-label.today{color:var(--green)}
.past-group-label.yesterday{color:var(--amber)}
.past-group-sub{font-size:.54rem;color:var(--text3);letter-spacing:.5px;margin-top:2px}
.past-group-badge{font-size:.5rem;color:var(--text3);letter-spacing:2px;text-transform:uppercase;border:1px solid var(--border2);padding:2px 8px;border-radius:2px;flex-shrink:0}

/* Individual saved entry */
.past-entry{padding:14px 22px;border-bottom:1px solid var(--border);transition:background .1s}
.past-entry:last-child{border-bottom:none}
.past-entry:hover{background:var(--bg2)}
.past-entry-time{font-size:.52rem;color:var(--text3);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:9px}
.past-bullet{display:flex;align-items:flex-start;gap:10px;padding:4px 0;font-size:.73rem;color:var(--text2);line-height:1.6;border-bottom:1px solid var(--border)}
.past-bullet:last-child{border-bottom:none}
.past-dot{color:var(--green);flex-shrink:0;line-height:1;margin-top:3px;font-size:.85rem}
.past-txt{word-break:break-word}

.past-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 40px;gap:14px;text-align:center;color:var(--text3)}
.past-empty-icon{font-size:2.5rem;opacity:.1}
.past-empty-msg{font-size:.63rem;letter-spacing:2px;text-transform:uppercase;line-height:2.4}
.past-empty-hint{font-size:.58rem;opacity:.5;line-height:1.8}

/* ══ STATS PAGE ══ */
#page-stats.active{display:block;padding:28px;overflow-y:auto}
.stats-h{font-family:var(--display);font-size:1rem;font-weight:700;margin-bottom:22px}
.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:28px}
.stat-card{border:1px solid var(--border);padding:20px;border-radius:2px;background:var(--bg2);position:relative;overflow:hidden}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--green);opacity:.4}
.stat-val{font-family:var(--display);font-size:2.2rem;font-weight:800;color:var(--green);line-height:1;margin-bottom:6px}
.stat-lbl{font-size:.52rem;letter-spacing:2.5px;text-transform:uppercase;color:var(--text3)}
.stats-sub{font-size:.52rem;letter-spacing:3px;text-transform:uppercase;color:var(--text3);margin-bottom:14px}
.sbar-wrap{margin-bottom:14px}
.sbar-row{display:flex;justify-content:space-between;margin-bottom:5px;font-size:.66rem}
.sbar-track{height:5px;background:var(--bg3);border-radius:3px;overflow:hidden}
.sbar-fill{height:100%;border-radius:3px;transition:width .7s cubic-bezier(.4,0,.2,1)}

/* ══ MODALS ══ */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:500;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s;backdrop-filter:blur(4px)}
.overlay.open{opacity:1;pointer-events:all}
.modal{background:var(--bg2);border:1px solid var(--border2);border-radius:3px;width:560px;max-width:95vw;max-height:90vh;overflow-y:auto;transform:translateY(14px);transition:transform .2s;box-shadow:0 0 80px rgba(0,0,0,.8)}
.overlay.open .modal{transform:translateY(0)}
.modal-wide{width:720px}
.modal-hd{display:flex;align-items:center;justify-content:space-between;padding:15px 20px;border-bottom:1px solid var(--border)}
.modal-title{font-size:.65rem;letter-spacing:2px;text-transform:uppercase;color:var(--green)}
.modal-x{background:none;border:none;color:var(--text3);cursor:pointer;font-size:1.3rem;line-height:1;transition:color .1s}
.modal-x:hover{color:var(--text)}
.modal-body{padding:20px}
.modal-foot{display:flex;gap:10px;justify-content:flex-end;padding:14px 20px;border-top:1px solid var(--border)}
.sess-sum{display:flex;gap:12px;padding:13px;background:var(--bg3);border:1px solid var(--border);border-radius:2px;margin-bottom:18px}
.sess-item{flex:1;text-align:center}
.sess-val{font-size:1rem;font-weight:700;color:var(--green);font-family:var(--mono)}
.sess-key{font-size:.48rem;color:var(--text3);letter-spacing:2px;text-transform:uppercase;margin-top:3px}
.form-lbl{display:block;font-size:.55rem;letter-spacing:2px;text-transform:uppercase;color:var(--text3);margin-bottom:7px}
/* Kolb modal */
.km-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.km-field{display:flex;flex-direction:column;gap:6px}
.km-label{display:flex;align-items:center;gap:8px;margin-bottom:2px}
.km-num{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.52rem;font-weight:700;flex-shrink:0}
.km-name{font-size:.6rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase}
.km-hint{font-size:.52rem;color:var(--text3);padding-left:28px;margin-top:-3px}
.km-field textarea{min-height:95px}
/* Kolb detail */
.kd-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.kd-cell{border:1px solid var(--border);border-radius:2px;padding:13px;background:var(--bg3)}
.kd-lbl{font-size:.52rem;letter-spacing:2px;text-transform:uppercase;font-weight:700;margin-bottom:8px}
.kd-txt{font-size:.7rem;color:var(--text2);line-height:1.65;white-space:pre-wrap;word-break:break-word}
/* Day detail */
.day-card{border:1px solid var(--border);border-left:3px solid var(--green);border-radius:2px;padding:11px 13px;margin-bottom:9px}
.day-card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
.day-card-sub{font-size:.68rem;font-weight:700}
.day-card-dur{font-size:.68rem;color:var(--green);font-weight:700}
.day-kolb{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px}
.day-kfield{font-size:.56rem;color:var(--text3);line-height:1.5}
.day-kfield strong{color:var(--text2);display:block;margin-bottom:2px;font-size:.52rem;letter-spacing:1px;text-transform:uppercase}

/* TOAST */
.toast{position:fixed;bottom:22px;right:22px;background:var(--bg3);border:1px solid var(--green);color:var(--green);padding:11px 18px;font-size:.68rem;letter-spacing:1px;z-index:9000;border-radius:2px;transform:translateY(60px);opacity:0;transition:all .22s;box-shadow:0 0 20px rgba(0,255,135,.12)}
.toast.show{transform:translateY(0);opacity:1}

/* RESPONSIVE */
@media(max-width:1200px){
  #page-tracker.active{grid-template-columns:260px 1fr 260px}
}
@media(max-width:900px){
  #page-tracker.active{grid-template-columns:1fr 1fr;grid-template-rows:auto auto}
  .tracker-center{grid-column:1/3;grid-row:1;border-right:none;border-bottom:1px solid var(--border)}
  .tracker-panel:first-child{grid-column:1;grid-row:2}
  .tracker-panel:last-child{grid-column:2;grid-row:2;border-left:1px solid var(--border)}
  .kolb-table{table-layout:auto}
  #page-output.active{grid-template-columns:1fr}
}
@media(max-width:600px){
  #page-tracker.active{grid-template-columns:1fr;grid-template-rows:auto auto auto}
  .tracker-center{grid-column:1;grid-row:1}
  .tracker-panel:first-child{grid-column:1;grid-row:2;border-right:none;border-bottom:1px solid var(--border)}
  .tracker-panel:last-child{grid-column:1;grid-row:3;border-left:none}
  .stats-grid{grid-template-columns:1fr 1fr}
  .km-grid,.kd-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
  <div class="logo"><span class="iq">IQ</span><span class="os">_OS</span><span class="logo-tag">v0.2</span></div>
  <div class="topbar-right">
    <span class="sys-date" id="sysDate"></span>
    <span class="sys-clock" id="sysClock">00:00:00</span>
  </div>
</div>

<!-- NAV -->
<nav class="nav">
  <button class="nav-btn active" onclick="showPage('tracker',this)">⏱ Tracker</button>
  <button class="nav-btn" onclick="showPage('calendar',this)">◻ Calendar</button>
  <button class="nav-btn" onclick="showPage('kolb',this)">◈ Kolb's Cycle</button>
  <button class="nav-btn" onclick="showPage('output',this)">▸ Output</button>
  <button class="nav-btn" onclick="showPage('stats',this)">◐ Stats</button>
</nav>

<!-- PAGES -->
<div class="pages">

  <!-- ══ TRACKER ══ -->
  <div class="page active" id="page-tracker">

    <!-- LEFT: Subjects -->
    <div class="tracker-panel">
      <div class="panel-head">
        <div class="panel-title">Subjects</div>
        <div class="panel-sub">Your study categories</div>
      </div>
      <div class="panel-scroll" id="subjectList"></div>
      <div class="add-subj-wrap">
        <div class="section-label">Add Subject</div>
        <div class="add-subj-row">
          <input type="text" id="newSubjectInput" placeholder="Subject name..." maxlength="30" onkeydown="if(event.key==='Enter')addSubject()">
          <input type="color" id="newSubjectColor" value="#00ff87">
          <button class="btn" onclick="addSubject()" style="padding:0 14px;font-size:1rem;height:36px">+</button>
        </div>
      </div>
    </div>

    <!-- CENTER: Timer -->
    <div class="tracker-center">
      <div class="section-label">Active Session</div>
      <div class="big-timer" id="bigTimer">00:00:00</div>
      <div class="big-timer-sub" id="bigTimerSub">— SELECT A SUBJECT —</div>
      <div class="timer-dot" id="timerDot"></div>
      <select id="activeSubjectSelect" class="timer-subject-sel" onchange="onSubjSelChange()">
        <option value="">— select subject —</option>
      </select>
      <div class="timer-btns">
        <button class="btn btn-green" id="startStopBtn" onclick="toggleTimer()" style="padding:12px 32px;font-size:.72rem">▶ START</button>
        <button class="btn btn-red" onclick="resetTimer()" style="padding:12px 20px">RESET</button>
      </div>
    </div>

    <!-- RIGHT: Today + streak -->
    <div class="tracker-panel" style="border-left:1px solid var(--border);border-right:none">
      <div class="panel-head">
        <div class="panel-title">Today's Sessions</div>
        <div class="panel-sub" id="todayTotal">Total: 0m</div>
      </div>
      <div class="panel-scroll" id="todayList"></div>
      <div class="streak-block">
        <div class="streak-num" id="streakNum">0</div>
        <div class="streak-info">
          <div class="streak-lbl">Day Streak</div>
          <div class="streak-sub">Consecutive days studied</div>
        </div>
      </div>
    </div>

  </div>

  <!-- ══ CALENDAR ══ -->
  <div class="page" id="page-calendar">
    <div class="cal-top">
      <button class="cal-nav" onclick="changeMonth(-1)">← PREV</button>
      <div class="cal-month" id="calMonth"></div>
      <button class="cal-nav" onclick="changeMonth(1)">NEXT →</button>
    </div>
    <div class="cal-grid" id="calGrid"></div>
  </div>

  <!-- ══ KOLB ══ -->
  <div class="page" id="page-kolb">
    <div class="kolb-topbar">
      <div style="display:flex;align-items:center;gap:10px">
        <div class="kolb-title">Kolb's Learning Cycle</div>
        <div class="kolb-badge">Experiential Learning</div>
      </div>
      <div class="kolb-topbar-r">
        <div id="kolbFilters" style="display:flex;gap:6px;flex-wrap:wrap"></div>
        <span style="font-size:.57rem;color:var(--text3);letter-spacing:2px" id="kolbCnt">0 entries</span>
      </div>
    </div>
    <div class="kolb-table-wrap">
      <table class="kolb-table">
        <thead>
          <tr>
            <th class="kc1-hd">
              <div class="kth-num">01</div>
              <div class="kth-title">Experience</div>
              <div class="kth-desc">What you did. Raw facts — topics, tasks, activities completed.</div>
              <div class="kth-cnt" id="kc1cnt">0 entries</div>
            </th>
            <th class="kc2-hd">
              <div class="kth-num">02</div>
              <div class="kth-title">Reflection</div>
              <div class="kth-desc">Why it went that way. Observations, feelings, honest assessment.</div>
              <div class="kth-cnt" id="kc2cnt">0 entries</div>
            </th>
            <th class="kc3-hd">
              <div class="kth-num">03</div>
              <div class="kth-title">Abstraction</div>
              <div class="kth-desc">Lessons extracted. Key insights, mental models, improvements.</div>
              <div class="kth-cnt" id="kc3cnt">0 entries</div>
            </th>
            <th class="kc4-hd">
              <div class="kth-num">04</div>
              <div class="kth-title">Experimentation</div>
              <div class="kth-desc">What you'll do differently. Concrete next actions.</div>
              <div class="kth-cnt" id="kc4cnt">0 entries</div>
            </th>
          </tr>
        </thead>
        <tbody id="kolbTableBody"></tbody>
      </table>
    </div>
  </div>

  <!-- ══ OUTPUT ══ -->
  <div class="page" id="page-output">

    <!-- LEFT: Write today's output -->
    <div class="out-write">
      <div class="out-head">
        <div class="out-head-title">Today's Output</div>
        <div class="out-head-sub" id="outDateLbl">—</div>
      </div>
      <div class="out-compose" id="outCompose"></div>
      <div class="out-add">
        <span class="out-add-bullet">◦</span>
        <input class="out-add-input" id="outAddInput" type="text"
          placeholder="What did you do? Hit Enter to add..."
          maxlength="220"
          onkeydown="if(event.key==='Enter')addOutItem()">
      </div>
      <div class="out-foot">
        <span class="out-cnt" id="outCnt">0 items</span>
        <div style="display:flex;gap:8px;align-items:center">
          <span style="font-size:.55rem;color:var(--text3)">↵ to add</span>
          <button class="btn btn-green" onclick="saveOutput()" style="padding:7px 16px;font-size:.6rem">Save & Clear ↗</button>
        </div>
      </div>
    </div>

    <!-- RIGHT: Past Accomplishments -->
    <div class="out-past">
      <div class="out-past-head">
        <div class="out-past-title">Past Accomplishments</div>
        <div class="out-past-total" id="pastTotal">—</div>
      </div>
      <div class="past-scroll" id="pastList"></div>
    </div>

  </div>

  <!-- ══ STATS ══ -->
  <div class="page" id="page-stats">
    <div class="stats-h">Performance Stats</div>
    <div class="stats-grid">
      <div class="stat-card"><div class="stat-val" id="statHrs">0h</div><div class="stat-lbl">Total Hours Logged</div></div>
      <div class="stat-card"><div class="stat-val" id="statSess">0</div><div class="stat-lbl">Total Sessions</div></div>
      <div class="stat-card"><div class="stat-val" id="statAvg">0m</div><div class="stat-lbl">Avg Session Length</div></div>
    </div>
    <div class="stats-sub">Hours by Subject</div>
    <div id="subjBars"></div>
  </div>

</div><!-- /pages -->

<!-- KOLB ENTRY MODAL -->
<div class="overlay" id="kolbModal">
  <div class="modal modal-wide">
    <div class="modal-hd">
      <div class="modal-title">◈ Kolb's Cycle — Log Session</div>
      <button class="modal-x" onclick="closeKolbModal()">×</button>
    </div>
    <div class="modal-body">
      <div class="sess-sum">
        <div class="sess-item"><div class="sess-val" id="mDur">—</div><div class="sess-key">Duration</div></div>
        <div class="sess-item"><div class="sess-val" id="mSub">—</div><div class="sess-key">Subject</div></div>
        <div class="sess-item"><div class="sess-val" id="mDate">—</div><div class="sess-key">Date</div></div>
      </div>
      <div class="km-grid">
        <div class="km-field">
          <div class="km-label"><div class="km-num" style="background:rgba(0,255,135,.1);color:var(--green)">01</div><span class="km-name" style="color:var(--green)">Experience</span></div>
          <div class="km-hint">What did you study? What happened?</div>
          <textarea id="k-exp" placeholder="e.g. Covered 3 chapters on integration, attempted 20 past paper problems..."></textarea>
        </div>
        <div class="km-field">
          <div class="km-label"><div class="km-num" style="background:rgba(116,185,255,.1);color:var(--blue)">02</div><span class="km-name" style="color:var(--blue)">Reflection</span></div>
          <div class="km-hint">Why did it go this way? What worked or didn't?</div>
          <textarea id="k-ref" placeholder="e.g. Lost focus after 40 mins, got stuck on substitution..."></textarea>
        </div>
        <div class="km-field">
          <div class="km-label"><div class="km-num" style="background:rgba(255,179,71,.1);color:var(--amber)">03</div><span class="km-name" style="color:var(--amber)">Abstraction</span></div>
          <div class="km-hint">What lessons did you extract?</div>
          <textarea id="k-abs" placeholder="e.g. I learn better with worked examples before attempting problems..."></textarea>
        </div>
        <div class="km-field">
          <div class="km-label"><div class="km-num" style="background:rgba(253,121,168,.1);color:var(--pink)">04</div><span class="km-name" style="color:var(--pink)">Experimentation</span></div>
          <div class="km-hint">What will you do differently next time?</div>
          <textarea id="k-xp" placeholder="e.g. Start with 20-min concept review, no phone first hour..."></textarea>
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn" onclick="closeKolbModal()">Skip</button>
      <button class="btn btn-green" onclick="saveKolb()">Save to Kolb's Log</button>
    </div>
  </div>
</div>

<!-- KOLB DETAIL MODAL -->
<div class="overlay" id="kdModal">
  <div class="modal modal-wide">
    <div class="modal-hd">
      <div><div class="modal-title" id="kdTitle">Session Detail</div><div style="font-size:.58rem;color:var(--text3);margin-top:3px" id="kdMeta"></div></div>
      <button class="modal-x" onclick="closeOv('kdModal')">×</button>
    </div>
    <div class="modal-body">
      <div class="kd-grid">
        <div class="kd-cell"><div class="kd-lbl" style="color:var(--green)">01 · Experience</div><div class="kd-txt" id="kd-exp">—</div></div>
        <div class="kd-cell"><div class="kd-lbl" style="color:var(--blue)">02 · Reflection</div><div class="kd-txt" id="kd-ref">—</div></div>
        <div class="kd-cell"><div class="kd-lbl" style="color:var(--amber)">03 · Abstraction</div><div class="kd-txt" id="kd-abs">—</div></div>
        <div class="kd-cell"><div class="kd-lbl" style="color:var(--pink)">04 · Experimentation</div><div class="kd-txt" id="kd-xp">—</div></div>
      </div>
    </div>
  </div>
</div>

<!-- DAY DETAIL MODAL -->
<div class="overlay" id="dayModal">
  <div class="modal">
    <div class="modal-hd">
      <div class="modal-title" id="dayTitle">Sessions</div>
      <button class="modal-x" onclick="closeOv('dayModal')">×</button>
    </div>
    <div class="modal-body" id="dayBody"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// ══ STATE ══
const S={
  subjects:[],sessions:[],outputDraft:[],outputEntries:[],
  activeSubject:null,running:false,timerStart:null,elapsed:0,timerIv:null,pending:null,
  calMonth:new Date().getMonth(),calYear:new Date().getFullYear(),
  kolbFilter:'all'
};

function save(){try{localStorage.setItem('iqos3',JSON.stringify({subjects:S.subjects,sessions:S.sessions,outputDraft:S.outputDraft,outputEntries:S.outputEntries}))}catch(e){}}
function load(){
  try{
    // try new key first, fall back to old keys for migration
    const raw=localStorage.getItem('iqos3')||localStorage.getItem('iqos2')||localStorage.getItem('iqos')||'{}';
    const d=JSON.parse(raw);
    if(d.subjects)S.subjects=d.subjects;
    if(d.sessions)S.sessions=d.sessions;
    if(d.outputDraft)S.outputDraft=d.outputDraft;
    if(d.outputEntries)S.outputEntries=d.outputEntries;
  }catch(e){}
}

// ══ UTILS ══
const fmtSec=s=>[Math.floor(s/3600),Math.floor((s%3600)/60),s%60].map(n=>String(n).padStart(2,'0')).join(':');
const fmtDur=s=>{const h=Math.floor(s/3600),m=Math.floor((s%3600)/60),sec=s%60;return h>0?`${h}h ${m}m`:m>0?`${m}m ${sec}s`:`${sec}s`};
const dStr=iso=>{try{const d=new Date(iso);return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}catch(e){return''}};
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const getSub=id=>S.subjects.find(s=>s.id===id);
const subTot=id=>S.sessions.filter(s=>s.subjectId===id).reduce((a,s)=>a+s.duration,0);
const toast=msg=>{const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2400)};
const closeOv=id=>document.getElementById(id).classList.remove('open');

// ══ NAV ══
function showPage(name,btn){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('page-'+name).classList.add('active');
  if(btn)btn.classList.add('active');
  ({
    tracker:()=>{renderSubjects();renderSubjectSelect();renderTodaySessions();calcStreak()},
    calendar:renderCalendar,
    kolb:()=>{renderKolbFilters();renderKolb()},
    output:()=>{renderOutDraft();renderPast()},
    stats:renderStats
  })[name]?.();
}

// ══ SUBJECTS ══
function addSubject(){
  const n=document.getElementById('newSubjectInput').value.trim(),c=document.getElementById('newSubjectColor').value;
  if(!n)return;
  if(S.subjects.find(s=>s.name.toLowerCase()===n.toLowerCase())){toast('Subject already exists');return}
  S.subjects.push({id:Date.now().toString(),name:n,color:c});
  document.getElementById('newSubjectInput').value='';
  save();renderSubjects();renderSubjectSelect();renderKolbFilters();
}
function delSubject(id){
  S.subjects=S.subjects.filter(s=>s.id!==id);
  if(S.activeSubject===id){S.activeSubject=null;updateSubDisplay()}
  save();renderSubjects();renderSubjectSelect();renderKolbFilters();
}
function setActiveSub(id){
  if(S.running)return;
  S.activeSubject=id;
  document.getElementById('activeSubjectSelect').value=id||'';
  updateSubDisplay();renderSubjects();
}
function onSubjSelChange(){S.activeSubject=document.getElementById('activeSubjectSelect').value||null;updateSubDisplay();renderSubjects()}
function updateSubDisplay(){
  const sub=getSub(S.activeSubject),el=document.getElementById('bigTimerSub');
  el.textContent=sub?sub.name.toUpperCase():'— SELECT A SUBJECT —';
  el.className='big-timer-sub'+(sub?' on':'');
}
function renderSubjects(){
  const el=document.getElementById('subjectList');
  if(!S.subjects.length){el.innerHTML='<div style="padding:14px 0;font-size:.65rem;color:var(--text3)">No subjects yet — add one below.</div>';return}
  el.innerHTML=S.subjects.map(s=>{
    const sec=subTot(s.id),lbl=sec>=3600?`${(sec/3600).toFixed(1)}h`:sec>=60?`${Math.floor(sec/60)}m`:`${sec}s`;
    return`<div class="subject-item${s.id===S.activeSubject?' active':''}" onclick="setActiveSub('${s.id}')">
      <div class="subj-dot" style="background:${s.color}"></div>
      <span class="subj-name">${esc(s.name)}</span>
      <span class="subj-hrs">${lbl}</span>
      <span class="subj-del" onclick="event.stopPropagation();delSubject('${s.id}')">✕</span>
    </div>`;
  }).join('');
}
function renderSubjectSelect(){
  const sel=document.getElementById('activeSubjectSelect'),cur=sel.value;
  sel.innerHTML='<option value="">— select subject —</option>'+S.subjects.map(s=>`<option value="${s.id}">${esc(s.name)}</option>`).join('');
  if(S.subjects.find(s=>s.id===cur))sel.value=cur;
}

// ══ TIMER ══
function toggleTimer(){S.running?stopTimer():startTimer()}
function startTimer(){
  if(!S.activeSubject){toast('Select a subject first');return}
  S.running=true;S.timerStart=Date.now()-S.elapsed*1000;
  S.timerIv=setInterval(tickTimer,1000);
  document.getElementById('startStopBtn').textContent='■ STOP';
  document.getElementById('startStopBtn').className='btn btn-red';
  document.getElementById('bigTimer').classList.add('running');
  document.getElementById('timerDot').classList.add('running');
}
function tickTimer(){
  S.elapsed=Math.floor((Date.now()-S.timerStart)/1000);
  document.getElementById('bigTimer').textContent=fmtSec(S.elapsed);
}
function stopTimer(){
  clearInterval(S.timerIv);S.running=false;
  const dur=S.elapsed,sid=S.activeSubject;
  S.pending={id:Date.now().toString(),subjectId:sid,duration:dur,date:new Date().toISOString(),kolb:{experience:'',reflection:'',abstraction:'',experimentation:''},notes:''};
  document.getElementById('startStopBtn').textContent='▶ START';
  document.getElementById('startStopBtn').className='btn btn-green';
  document.getElementById('bigTimer').classList.remove('running');
  document.getElementById('timerDot').classList.remove('running');
  openKolbModal(dur,sid);
}
function resetTimer(){
  if(S.running){clearInterval(S.timerIv);S.running=false;document.getElementById('startStopBtn').textContent='▶ START';document.getElementById('startStopBtn').className='btn btn-green';document.getElementById('bigTimer').classList.remove('running');document.getElementById('timerDot').classList.remove('running')}
  S.elapsed=0;S.timerStart=null;document.getElementById('bigTimer').textContent='00:00:00';
}

// ══ TODAY ══
function renderTodaySessions(){
  const today=new Date().toISOString().slice(0,10);
  const sess=S.sessions.filter(s=>dStr(s.date)===today).reverse();
  const tot=sess.reduce((a,s)=>a+s.duration,0);
  document.getElementById('todayTotal').textContent=`Total: ${tot?fmtDur(tot):'0m'}`;
  const el=document.getElementById('todayList');
  if(!sess.length){el.innerHTML='<div style="padding:20px;font-size:.62rem;color:var(--text3);text-align:center;letter-spacing:1.5px;text-transform:uppercase">No sessions yet today</div>';return}
  el.innerHTML=sess.map(s=>{
    const sub=getSub(s.subjectId),col=sub?sub.color:'var(--green)',note=s.kolb?.experience||s.notes||'';
    return`<div class="today-sess" style="border-left-color:${col}">
      <div class="subj-dot" style="background:${col}"></div>
      <span style="font-size:.68rem;font-weight:700;color:${col}">${sub?esc(sub.name):'?'}</span>
      <span class="today-sess-dur">${fmtDur(s.duration)}</span>
      ${note?`<span class="today-sess-note">${esc(note)}</span>`:''}
    </div>`;
  }).join('');
}

// ══ STREAK ══
function calcStreak(){
  if(!S.sessions.length){document.getElementById('streakNum').textContent='0';return}
  const days=[...new Set(S.sessions.map(s=>dStr(s.date)))].sort();
  let streak=0,check=new Date();check.setHours(0,0,0,0);
  const today=check.toISOString().slice(0,10),yest=new Date(check-86400000).toISOString().slice(0,10);
  if(!days.includes(today)&&!days.includes(yest)){document.getElementById('streakNum').textContent='0';return}
  if(!days.includes(today))check=new Date(check-86400000);
  for(let i=0;i<400;i++){if(days.includes(check.toISOString().slice(0,10))){streak++;check=new Date(check-86400000)}else break}
  document.getElementById('streakNum').textContent=streak;
}

// ══ CALENDAR ══
function renderCalendar(){
  const m=S.calMonth,y=S.calYear;
  const months=['January','February','March','April','May','June','July','August','September','October','November','December'];
  document.getElementById('calMonth').textContent=`${months[m]} ${y}`;
  const first=new Date(y,m,1).getDay(),dim=new Date(y,m+1,0).getDate(),today=new Date();
  const dnames=['SUN','MON','TUE','WED','THU','FRI','SAT'];
  let html=dnames.map(d=>`<div class="cal-hd">${d}</div>`).join('');
  for(let i=0;i<first;i++)html+=`<div class="cal-day empty"></div>`;
  for(let d=1;d<=dim;d++){
    const ds=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const isT=d===today.getDate()&&m===today.getMonth()&&y===today.getFullYear();
    const sess=S.sessions.filter(s=>dStr(s.date)===ds);
    const tot=sess.reduce((a,s)=>a+s.duration,0);
    const byS={};sess.forEach(s=>{byS[s.subjectId]=(byS[s.subjectId]||0)+s.duration});
    const pills=Object.entries(byS).slice(0,3).map(([id,sec])=>{const sub=getSub(id);return sub?`<span class="cal-pill" style="background:${sub.color}22;color:${sub.color}">${esc(sub.name.slice(0,9))} ${fmtDur(sec)}</span>`:''}).join('');
    html+=`<div class="cal-day${isT?' today':''}" onclick="showDayDetail('${ds}',${d})">
      <div class="cal-dn">${d}</div>${pills}${tot?`<span class="cal-tot">${fmtDur(tot)}</span>`:''}
    </div>`;
  }
  document.getElementById('calGrid').innerHTML=html;
}
function changeMonth(d){S.calMonth+=d;if(S.calMonth>11){S.calMonth=0;S.calYear++}if(S.calMonth<0){S.calMonth=11;S.calYear--}renderCalendar()}
function showDayDetail(ds,dn){
  const months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  document.getElementById('dayTitle').textContent=`${dn} ${months[S.calMonth]} ${S.calYear}`;
  const sess=S.sessions.filter(s=>dStr(s.date)===ds);
  const body=document.getElementById('dayBody');
  if(!sess.length){body.innerHTML='<div style="padding:20px;text-align:center;font-size:.65rem;color:var(--text3);letter-spacing:2px">No sessions this day</div>';document.getElementById('dayModal').classList.add('open');return}
  body.innerHTML=sess.map(s=>{
    const sub=getSub(s.subjectId),col=sub?sub.color:'var(--green)',k=s.kolb||{};
    return`<div class="day-card" style="border-left-color:${col}">
      <div class="day-card-top"><span class="day-card-sub" style="color:${col}">${sub?esc(sub.name):'Unknown'}</span><span class="day-card-dur">${fmtDur(s.duration)}</span></div>
      ${(k.experience||k.reflection||k.abstraction||k.experimentation)?`
      <div class="day-kolb">
        ${k.experience?`<div class="day-kfield"><strong style="color:var(--green)">Experience</strong>${esc(k.experience.slice(0,90))}${k.experience.length>90?'…':''}</div>`:''}
        ${k.reflection?`<div class="day-kfield"><strong style="color:var(--blue)">Reflection</strong>${esc(k.reflection.slice(0,90))}${k.reflection.length>90?'…':''}</div>`:''}
        ${k.abstraction?`<div class="day-kfield"><strong style="color:var(--amber)">Abstraction</strong>${esc(k.abstraction.slice(0,90))}${k.abstraction.length>90?'…':''}</div>`:''}
        ${k.experimentation?`<div class="day-kfield"><strong style="color:var(--pink)">Experimentation</strong>${esc(k.experimentation.slice(0,90))}${k.experimentation.length>90?'…':''}</div>`:''}
      </div>`:`<div style="font-size:.6rem;color:var(--text3);margin-top:6px">No Kolb notes logged.</div>`}
    </div>`;
  }).join('');
  document.getElementById('dayModal').classList.add('open');
}

// ══ KOLB MODAL ══
function openKolbModal(dur,sid){
  const sub=getSub(sid);
  document.getElementById('mDur').textContent=fmtDur(dur);
  document.getElementById('mSub').textContent=sub?sub.name:'?';
  document.getElementById('mDate').textContent=new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'short'});
  ['k-exp','k-ref','k-abs','k-xp'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('kolbModal').classList.add('open');
}
function closeKolbModal(){
  document.getElementById('kolbModal').classList.remove('open');
  if(S.pending){S.sessions.push(S.pending);S.pending=null;S.elapsed=0;save();renderAll();toast('Session saved')}
}
function saveKolb(){
  if(S.pending){
    S.pending.kolb={experience:document.getElementById('k-exp').value.trim(),reflection:document.getElementById('k-ref').value.trim(),abstraction:document.getElementById('k-abs').value.trim(),experimentation:document.getElementById('k-xp').value.trim()};
    S.pending.notes=S.pending.kolb.experience;
    S.sessions.push(S.pending);S.pending=null;S.elapsed=0;save();renderAll();toast('Kolb entry saved ✓');
  }
  document.getElementById('kolbModal').classList.remove('open');
}

// ══ KOLB BOARD ══
function renderKolbFilters(){
  const el=document.getElementById('kolbFilters');if(!el)return;
  el.innerHTML=`<button class="filter-btn${S.kolbFilter==='all'?' active':''}" onclick="setKolbF('all',this)">All</button>`+S.subjects.map(s=>`<button class="filter-btn${S.kolbFilter===s.id?' active':''}" onclick="setKolbF('${s.id}',this)">${esc(s.name)}</button>`).join('');
}
function setKolbF(id,btn){
  S.kolbFilter=id;
  document.querySelectorAll('#kolbFilters .filter-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');renderKolb();
}
function renderKolb(){
  let sess=[...S.sessions].reverse();
  if(S.kolbFilter!=='all')sess=sess.filter(s=>s.subjectId===S.kolbFilter);
  document.getElementById('kolbCnt').textContent=`${sess.length} entr${sess.length===1?'y':'ies'}`;

  const fields=['experience','reflection','abstraction','experimentation'];

  // Update header counts
  fields.forEach((field,i)=>{
    const filled=sess.filter(s=>s.kolb&&s.kolb[field]);
    document.getElementById(`kc${i+1}cnt`).textContent=`${filled.length} entr${filled.length===1?'y':'ies'}`;
  });

  const tbody=document.getElementById('kolbTableBody');
  if(!sess.length){
    tbody.innerHTML=`<tr class="kolb-empty-row"><td colspan="4">No sessions logged yet.<br>Start a timer session to begin filling your Kolb cycle.</td></tr>`;
    return;
  }

  tbody.innerHTML=sess.map(s=>{
    const sub=getSub(s.subjectId),col=sub?sub.color:'var(--green)',k=s.kolb||{};
    const date=new Date(s.date).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
    const meta=`<div class="ktd-meta">
      <div class="subj-dot" style="background:${col}"></div>
      <span class="ktd-subj" style="color:${col}">${sub?esc(sub.name):'?'}</span>
      <span class="ktd-dur">${fmtDur(s.duration)}</span>
      <span class="ktd-date">${date}</span>
    </div>`;

    const cell=field=>{
      const text=k[field]||(field==='experience'?s.notes:'');
      return text?`<div class="ktd-text">${esc(text)}</div>`:`<div class="ktd-empty">—</div>`;
    };

    return`<tr onclick="showKolbDetail('${s.id}')">
      <td class="kc1-td">${meta}${cell('experience')}</td>
      <td class="kc2-td">${cell('reflection')}</td>
      <td class="kc3-td">${cell('abstraction')}</td>
      <td class="kc4-td">${cell('experimentation')}</td>
    </tr>`;
  }).join('');
}
function showKolbDetail(id){
  const s=S.sessions.find(x=>x.id===id);if(!s)return;
  const sub=getSub(s.subjectId),col=sub?sub.color:'var(--green)',k=s.kolb||{};
  document.getElementById('kdTitle').innerHTML=`<span style="color:${col}">${sub?esc(sub.name):'Session'}</span> · ${fmtDur(s.duration)}`;
  document.getElementById('kdMeta').textContent=new Date(s.date).toLocaleString('en-GB',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});
  document.getElementById('kd-exp').textContent=k.experience||s.notes||'— not filled in —';
  document.getElementById('kd-ref').textContent=k.reflection||'— not filled in —';
  document.getElementById('kd-abs').textContent=k.abstraction||'— not filled in —';
  document.getElementById('kd-xp').textContent=k.experimentation||'— not filled in —';
  document.getElementById('kdModal').classList.add('open');
}

// ══ OUTPUT ══
function addOutItem(){
  const inp=document.getElementById('outAddInput'),text=inp.value.trim();if(!text)return;
  S.outputDraft.push({id:Date.now().toString(),text});inp.value='';save();renderOutDraft();inp.focus();
}
function delOutItem(id){S.outputDraft=S.outputDraft.filter(i=>i.id!==id);save();renderOutDraft()}
function saveOutput(){
  if(!S.outputDraft.length){toast('Add at least one item first');return}
  S.outputEntries.unshift({id:Date.now().toString(),date:new Date().toISOString(),items:[...S.outputDraft]});
  S.outputDraft=[];save();renderOutDraft();renderPast();toast('Saved to Past Accomplishments ✓');
}
function renderOutDraft(){
  const el=document.getElementById('outCompose'),cnt=document.getElementById('outCnt'),lbl=document.getElementById('outDateLbl');
  lbl.textContent=new Date().toLocaleDateString('en-GB',{weekday:'long',day:'2-digit',month:'long',year:'numeric'});
  cnt.textContent=`${S.outputDraft.length} item${S.outputDraft.length!==1?'s':''}`;
  if(!S.outputDraft.length){el.innerHTML=`<div class="out-empty"><div class="out-empty-icon">◦</div><div>Nothing yet — log what you're doing</div></div>`;return}
  el.innerHTML=S.outputDraft.map(item=>`<div class="out-item"><span class="out-bullet">•</span><span class="out-item-txt">${esc(item.text)}</span><span class="out-item-del" onclick="delOutItem('${item.id}')">✕</span></div>`).join('');
}
function renderPast(){
  const el=document.getElementById('pastList');
  const totalEl=document.getElementById('pastTotal');
  const total=S.outputEntries.reduce((a,e)=>a+e.items.length,0);
  if(totalEl) totalEl.textContent=`${S.outputEntries.length} saved · ${total} items total`;

  if(!S.outputEntries.length){
    el.innerHTML=`<div class="past-empty">
      <div class="past-empty-icon">◦</div>
      <div class="past-empty-msg">No past accomplishments yet</div>
      <div class="past-empty-hint">Write your output on the left<br>and hit Save & Clear.<br>It will appear here grouped by date.</div>
    </div>`;
    return;
  }

  // Group by calendar date
  const today=new Date(); today.setHours(0,0,0,0);
  const yest=new Date(today-86400000);
  const todayKey=dStr(today.toISOString());
  const yestKey=dStr(yest.toISOString());

  const groups={};
  S.outputEntries.forEach(entry=>{
    const key=dStr(entry.date);
    if(!groups[key]) groups[key]={dateKey:key,date:new Date(entry.date),entries:[]};
    groups[key].entries.push(entry);
  });

  const sortedKeys=Object.keys(groups).sort((a,b)=>b.localeCompare(a));

  el.innerHTML=sortedKeys.map(key=>{
    const g=groups[key];
    const isToday=key===todayKey, isYest=key===yestKey;
    const labelText=isToday?'Today':isYest?'Yesterday':g.date.toLocaleDateString('en-GB',{weekday:'long',day:'2-digit',month:'long',year:'numeric'});
    const labelCls='past-group-label'+(isToday?' today':isYest?' yesterday':'');
    const subText=isToday?'Today · '+g.date.toLocaleDateString('en-GB',{day:'2-digit',month:'long',year:'numeric'}):isYest?'Yesterday · '+g.date.toLocaleDateString('en-GB',{day:'2-digit',month:'long',year:'numeric'}):'';
    const groupTotal=g.entries.reduce((a,e)=>a+e.items.length,0);

    const entriesHtml=g.entries.map(entry=>{
      const t=new Date(entry.date).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});
      return`<div class="past-entry">
        <div class="past-entry-time">Saved at ${t} · ${entry.items.length} item${entry.items.length!==1?'s':''}</div>
        ${entry.items.map(item=>`<div class="past-bullet"><span class="past-dot">•</span><span class="past-txt">${esc(item.text)}</span></div>`).join('')}
      </div>`;
    }).join('');

    return`<div class="past-group">
      <div class="past-group-hd">
        <div>
          <div class="${labelCls}">${labelText}</div>
          ${subText?`<div class="past-group-sub">${subText}</div>`:''}
        </div>
        <div class="past-group-badge">${groupTotal} item${groupTotal!==1?'s':''}</div>
      </div>
      ${entriesHtml}
    </div>`;
  }).join('');
}

// ══ STATS ══
function renderStats(){
  const tot=S.sessions.reduce((a,s)=>a+s.duration,0),n=S.sessions.length,avg=n?Math.floor(tot/n):0;
  document.getElementById('statHrs').textContent=tot>=3600?`${(tot/3600).toFixed(1)}h`:`${Math.floor(tot/60)}m`;
  document.getElementById('statSess').textContent=n;
  document.getElementById('statAvg').textContent=avg>=3600?`${(avg/3600).toFixed(1)}h`:`${Math.floor(avg/60)}m`;
  const bars=document.getElementById('subjBars');
  if(!S.subjects.length){bars.innerHTML='<div style="font-size:.65rem;color:var(--text3)">No subjects yet.</div>';return}
  const maxS=Math.max(...S.subjects.map(s=>subTot(s.id)),1);
  bars.innerHTML=S.subjects.map(s=>{
    const sec=subTot(s.id),pct=Math.round(sec/maxS*100),lbl=sec>=3600?`${(sec/3600).toFixed(1)}h`:sec>=60?`${Math.floor(sec/60)}m`:`${sec}s`;
    return`<div class="sbar-wrap">
      <div class="sbar-row"><span style="display:flex;align-items:center;gap:8px"><span style="width:8px;height:8px;border-radius:50%;background:${s.color};display:inline-block"></span>${esc(s.name)}</span><span style="color:var(--text2)">${lbl}</span></div>
      <div class="sbar-track"><div class="sbar-fill" style="width:${pct}%;background:${s.color}"></div></div>
    </div>`;
  }).join('');
}

// ══ CLOCK ══
function tickClock(){
  const n=new Date();
  document.getElementById('sysClock').textContent=n.toTimeString().slice(0,8);
  document.getElementById('sysDate').textContent=n.toLocaleDateString('en-GB',{weekday:'short',day:'2-digit',month:'short',year:'numeric'});
}

// ══ RENDER ALL ══
function renderAll(){
  renderSubjects();renderSubjectSelect();
  renderTodaySessions();calcStreak();
  renderKolbFilters();renderKolb();
  renderOutDraft();renderPast();
  renderStats();renderCalendar();
}

// ══ INIT ══
document.addEventListener('DOMContentLoaded',()=>{
  load();
  if(!S.subjects.length){
    S.subjects=[{id:'1',name:'Mathematics',color:'#00ff87'},{id:'2',name:'Physics',color:'#ff6b6b'},{id:'3',name:'Chemistry',color:'#ffd93d'},{id:'4',name:'English',color:'#74b9ff'}];
    save();
  }
  renderAll();
  tickClock();
  setInterval(tickClock,1000);
});
</script>
